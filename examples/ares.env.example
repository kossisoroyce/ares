# Ares environment configuration (12-factor / cloud friendly).
# Copy to /etc/ares/ares.env and reference it from the systemd unit via
#   EnvironmentFile=/etc/ares/ares.env
# Never commit real secrets.

# --- State / config -------------------------------------------------------
# ARES_CONFIG=/etc/ares/config.yaml
# ARES_STATE_DIR=/var/lib/ares         # dev only; prod uses storage.path in config

# --- AI investigator (OpenRouter is the default provider) -----------------
# Get a key at https://openrouter.ai/keys and pick any model id it offers.
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1   # override only if proxying

# Alternatives (set investigation.model_provider in config.yaml to match):
#   OpenAI / self-hosted gateway:
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o
#   Anthropic native:
# ANTHROPIC_API_KEY=sk-ant-...

# --- Notifications --------------------------------------------------------
# Global severity floor for all channels (info|low|medium|high|critical).
ARES_NOTIFY_MIN_SEVERITY=high

# Slack incoming webhook (recommended default for teams).
# Create at https://api.slack.com/messaging/webhooks
ARES_SLACK_WEBHOOK=https://hooks.slack.com/services/T000/B000/xxxxxxxx

# Generic JSON webhook — route incidents into any internal system.
# ARES_NOTIFY_WEBHOOK=https://ops.internal.example/ares

# PagerDuty Events API v2 routing key — pages on-call for critical incidents.
# ARES_PAGERDUTY_ROUTING_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email / SMTP (universal fallback).
# ARES_SMTP_HOST=smtp.example.com
# ARES_SMTP_PORT=587
# ARES_SMTP_USER=ares@example.com
# ARES_SMTP_PASSWORD=app-password
# ARES_SMTP_FROM=ares@example.com
# ARES_SMTP_TO=secops@example.com,oncall@example.com
